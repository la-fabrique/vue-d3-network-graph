{
  "name": "vue-d3-network-graph",
  "version": "1.0.0-beta.3",
  "description": "Vue component to graph networks using d3-force",
  "author": "Deka",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/la-fabrique/vue-d3-network-graph.git"
  },
  "main": "./dist/vue-d3-network-graph.umd.js",
  "module": "./dist/vue-d3-network-graph.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-d3-network-graph.mjs",
      "require": "./dist/vue-d3-network-graph.umd.js"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    },
    "./D3NetworkGraph.vue": {
      "default": "./src/D3NetworkGraph.vue"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "lib:type-check": "vue-tsc --noEmit",
    "lib:test": "vitest",
    "lib:build": "vue-tsc --noEmit && vite build",
    "lib:lint": "eslint --fix src",
    "lib:format": "prettier .  --write",
    "docs:api": "node ./scripts/doc.mjs",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vue-tsc --noEmit && vite build && node ./scripts/doc.mjs && vuepress build docs && histoire build",
    "docs:preview": "vite preview --outDir ./dist-docs --base=/vue-d3-network-graph/",
    "story:dev": "histoire dev",
    "story:preview": "histoire preview"
  },
  "dependencies": {
    "@vueuse/components": "15.1.0",
    "@vueuse/core": "^15.1.0",
    "d3-force": "^3.0.1",
    "d3-hierarchy": "^3.1.3",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.2",
    "@mdi/font": "7.4.47",
    "@mdi/js": "^7.4.47",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/d3": "^7.4.3",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vuepress/bundler-vite": "^2.0.0-rc.33",
    "@vuepress/client": "^2.0.0-rc.33",
    "@vuepress/theme-default": "^2.0.0-rc.142",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "histoire": "1.0.0-beta.2",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "roboto-fontface": "0.10.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.1.2",
    "vue-router": "^5.5.2",
    "vue-tsc": "^3.3.14",
    "vuepress": "^2.0.0-rc.33"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "overrides": {
    "histoire": {
      "zod": "^4.6.7",
      "@modelcontextprotocol/server": "^2.4.0",
      "@hono/node-server": "^2.1.11",
      "esbuild": "^0.28.2"
    },
    "@microsoft/api-extractor": {
      "minimatch": "^11.0.9"
    }
  }
}
